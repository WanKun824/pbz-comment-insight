      "O2": "\u62a5\u95ee\u9898\uff1a\u53cd\u9988\u5177\u4f53\u95ee\u9898\u3001\u62a5BUG\u3001\u63cf\u8ff0\u6545\u969c",
      "O3": "\u63d0\u95ee\uff1a\u63d0\u95ee\u3001\u6c42\u52a9\u3001\u6c42\u653b\u7565\u3001\u8be2\u95ee\u914d\u7f6e",
      "O4": "\u63d0\u5efa\u8bae\uff1a\u63d0\u5efa\u8bae\u3001\u63d0\u8bc9\u6c42\u3001\u5e0c\u671b\u6539\u6210\u4ec0\u4e48\u6837",
      "O5": "\u8bb2\u7ecf\u5386\uff1a\u5206\u4eab\u81ea\u5df1\u7684\u7ecf\u5386\u3001\u6218\u7ee9\u3001\u611f\u53d7",
