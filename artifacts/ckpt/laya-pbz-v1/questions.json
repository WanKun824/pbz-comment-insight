{
  "topic_l1": {
    "type": "choice",
    "instructions": "\u8fd9\u6761\u8bc4\u8bba\u4e3b\u8981\u5728\u8ba8\u8bba\u54ea\u4e00\u7c7b\u8bdd\u9898\uff1f",
    "criteria": {
      "O1": "\u6218\u6597\uff1a\u6218\u6597\u624b\u611f\u3001\u62db\u5f0f\u8fde\u6bb5\u3001\u62fc\u5200\u683c\u6321\u3001\u96be\u5ea6\u3001BOSS",
      "O2": "\u5185\u5bb9\u54c1\u8d28\uff1a\u5267\u60c5\u53d9\u4e8b\u3001\u89d2\u8272\u3001\u7f8e\u672f\u3001\u97f3\u4e50\u3001\u5173\u5361\u5730\u56fe\u3001\u6d41\u7a0b\u5185\u5bb9\u91cf",
      "O3": "\u6280\u672f\u6027\u80fd\uff1a\u5e27\u6570\u4f18\u5316\u3001\u914d\u7f6e\u9a71\u52a8\u3001\u5d29\u6e83BUG\u3001\u624b\u67c4\u5916\u8bbe\u3001\u5e73\u53f0\u9002\u914d",
      "O4": "\u5546\u4e1a\u4ea7\u54c1\uff1a\u5b9a\u4ef7\u6027\u4ef7\u6bd4\u3001\u9500\u91cf\u3001\u4e70\u4e0d\u4e70\u3001\u7248\u672c\u5468\u8fb9\u3001\u5ba3\u53d1\u9884\u544a",
      "O5": "\u884c\u4e1a\u751f\u6001\uff1a\u56fd\u4ea73A\u610f\u4e49\u3001\u4e0e\u5176\u4ed6\u6e38\u620f\u5bf9\u6bd4\u3001\u5a92\u4f53\u8bc4\u5206\u3001\u5ba1\u6838\u653f\u7b56",
      "O6": "\u89c6\u9891\u4e0eUP\u4e3b\uff1a\u8fd9\u4e2a\u89c6\u9891\u548cUP\u4e3b\u672c\u8eab\uff1a\u89e3\u8bf4\u3001\u526a\u8f91\u3001\u50ac\u66f4\u3001\u653b\u7565\u4ef7\u503c",
      "O7": "\u793e\u533a\u8206\u8bba\uff1a\u8206\u8bba\u8282\u594f\u3001\u9ed1\u5b50\u6c34\u519b\u3001\u70ed\u6897\u6bb5\u5b50\u3001\u73a9\u5bb6\u793e\u7fa4\u4e0e\u4e89\u8bba",
      "O8": "\u73a9\u5bb6\u81ea\u8ff0\uff1a\u73a9\u5bb6\u4e2a\u4eba\u7ecf\u5386\u4e0e\u60c5\u7eea\uff1a\u4e70\u4e86\u901a\u5173\u4e86\u3001\u8bf7\u5047\u3001\u611f\u52a8\u3001\u672c\u547d"
    }
  },
  "valid": {
    "type": "choice",
    "instructions": "\u8fd9\u6761\u6e38\u620f\u89c6\u9891\u8bc4\u8bba\u5c5e\u4e8e\u54ea\u79cd\u7c7b\u578b\uff1f",
    "criteria": {
      "O1": "\u6709\u5b9e\u8d28\u5185\u5bb9\uff1a\u6709\u5b9e\u8d28\u89c2\u70b9\u3001\u4f53\u9a8c\u63cf\u8ff0\u3001\u4fe1\u606f\u6216\u95ee\u9898\u53cd\u9988",
      "O2": "\u73a9\u6897\u4e92\u52a8\uff1a\u73a9\u6897\u3001\u8c03\u4f83\u3001\u63a5\u9f99\u3001\u60c5\u7eea\u4e92\u52a8\uff0c\u65e0\u5b9e\u8d28\u89c2\u70b9",
      "O3": "\u788e\u7247\u65e0\u6cd5\u5224\u65ad\uff1a\u8fc7\u77ed\u6216\u8131\u79bb\u4e0a\u4e0b\u6587\u65e0\u6cd5\u5224\u65ad\uff0c\u7eaf\u8868\u60c5\u3001\u5355\u8bcd\u3001\u9644\u548c",
      "O4": "\u5e7f\u544a\u5783\u573e\uff1a\u5e7f\u544a\u3001\u5f15\u6d41\u3001\u8bc8\u9a97\u3001\u4e0e\u6e38\u620f\u548c\u89c6\u9891\u5b8c\u5168\u65e0\u5173"
    }
  },
  "speech_act": {
